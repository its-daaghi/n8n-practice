    {
      "parameters": {
        "jsCode": "const toolCallId = $input.first().json.body.message.toolCalls[0].id;\nconst date = $input.first().json.body.message.toolCalls[0].function.arguments.date;\n\n// Extract only the date part safely\nconst dateOnly = date.split('T')[0];\n\n// Pakistan Standard Time is UTC+5 — fixed\nconst start = `${dateOnly}T08:00:00+05:00`;\nconst end   = `${dateOnly}T17:00:00+05:00`;\n\nreturn [{\n  json: {\n    toolCallId,\n    date: dateOnly,\n    start,\n    end\n  }\n}];"
      },
