      "id": "b8fb763d-f46c-497e-a8ef-3d648da1f519",
      "name": "Respond to Webhook1"
    },
    {
      "parameters": {
        "jsCode": "// Get calendar events from input\nconst allItems = $input.all();\n\n// Get toolCallId and working hours from \"Code in JavaScript\" node\nconst codeData = $('Code in JavaScript').first().json;\nconst workStart = new Date(codeData.start);\nconst workEnd   = new Date(codeData.end);\nconst toolCallId = codeData.toolCallId;\n\n// Build booked slots safely\nconst booked = allItems\n  .map(i => i.json)\n  .filter(e => e && e.start && e.start.dateTime && e.end && e.end.dateTime)\n  .map(e => ({\n    start: new Date(e.start.dateTime),\n    end:   new Date(e.end.dateTime)\n  }))\n  .sort((a, b) => a.start - b.start);\n\n// Find free 60 min gaps\nlet freeSlots = [];\nlet cursor = new Date(workStart);\n\nfor (const appt of booked) {\n  if ((appt.start - cursor) >= 60 * 60 * 1000) {\n    freeSlots.push({ \n      start: new Date(cursor), \n      end: new Date(appt.start) \n    });\n  }\n  if (appt.end > cursor) cursor = new Date(appt.end);\n}\n\n// Check gap after last appointment\nif ((workEnd - cursor) >= 60 * 60 * 1000) {\n  freeSlots.push({ \n    start: new Date(cursor), \n    end: new Date(workEnd) \n  });\n}\n\n// Format to Pakistan readable time\nfunction toPKT(d) {\n  const pkt = new Date(d.getTime() + 5 * 60 * 60 * 1000);\n  let h = pkt.getUTCHours();\n  const m = String(pkt.getUTCMinutes()).padStart(2, '0');\n  const ampm = h >= 12 ? 'PM' : 'AM';\n  h = h % 12 || 12;\n  return `${h}:${m} ${ampm}`;\n}\n\nconst formatted = freeSlots.map(s => toPKT(s.start));\nconst message = formatted.length > 0\n  ? `Available slots are: ${formatted.join(', ')}`\n  : 'Sorry, no available slots for this day';\n\nreturn [{ json: { toolCallId, formatted, message } }];"
      },
