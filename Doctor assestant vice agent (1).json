        "responseBody": "{\n  \"results\": [{\n    \"toolCallId\": \"{{ $('Code').first().json.toolCallId }}\",\n    \"result\": \"Appointment successfully booked for {{ $('Code').first().json.name }} on {{ $('Code').first().json.start }}\"\n  }]\n}",
