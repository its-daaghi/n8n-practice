      "id": "0ed845d8-8e27-4758-b1ae-b7d0ccc3e4a6",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "jsCode": "const args = $input.first().json.body.message.toolCalls[0].function.arguments;\nconst toolCallId = $input.first().json.body.message.toolCalls[0].id;\n\n// Extract date only\nconst dateOnly = args.date.split('T')[0];\n\n// Extract time part safely\nlet timePart = '09:00:00';\nif (args.date.includes('T')) {\n  timePart = args.date.split('T')[1].substring(0, 8);\n}\n\n// Build clean start with Pakistan timezone\nconst start = `${dateOnly}T${timePart}+05:00`;\n\n// Calculate end = start + 60 minutes CORRECTLY\nconst startMs = new Date(start).getTime();\nconst endMs = startMs + (60 * 60 * 1000);\n\n// Build end time manually to keep +05:00\nconst endDate = new Date(endMs);\nconst endHours = String(endDate.getUTCHours() + 5).padStart(2, '0');\nconst endMins = String(endDate.getUTCMinutes()).padStart(2, '0');\nconst endSecs = String(endDate.getUTCSeconds()).padStart(2, '0');\nconst end = `${dateOnly}T${endHours}:${endMins}:${endSecs}+05:00`;\n\nreturn [{\n  json: {\n    toolCallId,\n    name:  args.name  || '',\n    phone: args.Phone || args.phone || '',\n    dob:   args.date_of_birth || '',\n    note:  args.note  || '',\n    start,\n    end,\n    title: `Appointment - ${args.name}`\n  }\n}];"
      },
